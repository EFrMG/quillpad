{"number": 13, "kind": "pr", "state": "open", "title": "Show note age in `list` output", "url": "https://github.com/someonesalter/quillpad/pull/13", "author": "someonesalter", "created_at": "2026-10-07T06:56:52Z", "updated_at": "2026-10-08T02:08:22Z", "labels": [], "comments_count": 3, "proposed_labels": [], "labels_reviewed": false, "action": "", "reason": "", "triaged_at": "", "triaged_by": "", "batch_id": "", "agent_notes": "Read the full diff and all three comments. The age column is added to the default `list` output, which a reviewer says will break scripts; the author agreed to move it behind a flag but has not pushed that yet. A second reviewer notes that modification time is unreliable after a restore or sync.", "review_request": null, "maintainer_notes": "", "first_seen_at": "2026-10-19T14:45:48Z", "last_synced_at": "2026-10-19T14:56:55Z", "state_reason": null, "item_score": {"rubric": "item-quality-v1", "value": 3, "dimensions": {"correctness": 1, "safeguards": 1, "reviewability": 1}, "reason": "Correctness 1: the age is right today, but modification time is unreliable after a restore or sync. Safeguards 1: no test, and the default output changes. Reviewability 1: ten focused lines.", "suggestion": "Wait for the author to move the column behind a flag, then review again.", "snapshot_id": "f10a0e19c537d63a06b9edb601063b5e23d0dd2d46f85aea669bfa29794282bb", "source_repository": {"database_id": 1408378170, "full_name": "someonesalter/quillpad", "host": "github.com", "node_id": "R_kgDOU_IlOg"}, "revision": {"base_sha": "d7b7ff5a5e3c6fa86484be4714484c7e26773b6d", "head_sha": "f94caa4e46076ad75aaa2957f1fcdcf69a8cf9f4", "updated_at": "2026-10-08T02:08:22Z"}, "coverage": {"checks": "complete", "closing_issues": "complete", "comments": "complete", "diff": "complete", "files": "complete", "review_comments": "complete", "reviews": "complete", "summary": "complete"}, "assessed_at": "2026-10-19T14:46:18Z", "assessed_by": "agent:Maya Ortiz"}, "head_sha": "f94caa4e46076a